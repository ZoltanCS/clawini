# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-side only!): needed for memory extraction,
# personalized suggestions and account deletion
SUPABASE_SERVICE_KEY=your-service-role-key

# NVIDIA NIM API Key (OpenAI-compatible endpoint)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key

# Google Gemini API key (needed only for Gemini models)
# Get one from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# AWS Bedrock credentials (needed only for Claude/Nova models)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token-if-required
# AWS_CLAUDE_REGION=eu-central-1

# OpenCode Zen API Key (OpenAI-compatible endpoint: https://opencode.ai/zen/go/v1)
# OPENCODE_API_KEY=your-opencode-api-key

# Tavily Search API Key (optional, for web search)
# TAVILY_API_KEY=your-tavily-key
